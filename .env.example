# WEB4 Engine — Environment Variables
# Copy to .env and fill in values

# Engine
MZC_ENGINE_NAME=WEB4_BLACK_MUCIZEWORK
MZC_ENGINE_MODE=BLACK
MZC_API_VERSION=1.0
MZC_PORT=5002

# Security
MZC_JWT_SECRET=
MZC_CORS_ORIGINS=*

# Storage
MZC_DATABASE_URL=json://storage/db/db.json

# Solana
MZC_RPC_URL=https://api.devnet.solana.com

# Redis
MZC_REDIS_URL=

# Observability
MZC_LOG_LEVEL=INFO
MZC_LOG_FORMAT=json
